{
  "name": "volleytable-pro",
  "version": "1.0.0",
  "description": "VolleyTable Pro Desktop",
  "main": "main.js",
  "author": "Thalis Maschio",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.volleytable.pro",
    "productName": "VolleyTablePro",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "nsis": "^0.0.0"
  }
}
